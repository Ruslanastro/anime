---
// Header.astro
// Шапка сайта с логотипом, названием и переключателем темы
---

<div class="sticky top-0 z-50 bg-[var(--bg)]/95 backdrop-blur-lg border-b border-[var(--border)]">
  <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
    <div class="flex items-center gap-x-4 cursor-pointer select-none hover:opacity-90 active:opacity-75 transition-opacity" 
         id="logo-link"
         title="Перейти на главную">
      <div class="w-12 h-12 bg-gradient-to-br from-violet-600 to-fuchsia-500 rounded-2xl flex items-center justify-center">
        <i class="fa-solid fa-tv text-white text-3xl"></i>
      </div>
      <div>
        <h1 class="text-3xl font-bold tracking-tighter section-header">Аниме Топ 2026</h1>
        <p class="text-sm text-[var(--text-muted)] -mt-1">54 тайтла • MyAnimeList • Май 2026</p>
      </div>
    </div>

    <div class="flex items-center gap-x-4">
      <!-- Theme Toggle -->
      <div class="flex items-center bg-[var(--card)] rounded-2xl p-1 border border-[var(--border)]">
        <button id="dark-btn"
                class="px-4 py-1.5 rounded-xl text-sm font-medium flex items-center gap-x-2 bg-white/10 dark:bg-white/10">
          <i class="fa-solid fa-moon"></i>
          <span>Тёмная</span>
        </button>
        <button id="light-btn"
                class="px-4 py-1.5 rounded-xl text-sm font-medium flex items-center gap-x-2 hover:bg-white/5">
          <i class="fa-solid fa-sun"></i>
          <span>Светлая</span>
        </button>
      </div>

      <div class="text-xs px-3 py-1 bg-emerald-500/10 text-emerald-400 rounded-full flex items-center gap-x-1.5">
        <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
        <span>Данные обновлены</span>
      </div>
    </div>
  </div>
</div>