---
// Header.astro
// Шапка с навигацией — вариант C «Тёмное стекло + градиентная кромка»
// Верхний ряд: бренд, кнопки темы/случайное, бейдж
// Нижний ряд: вкладки (role="tablist") со светящейся индикацией
---

<header class="site-header sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 pt-4">
    <!-- Верхний ряд: бренд + действия -->
    <div class="flex items-center justify-between gap-4">
      <div
        class="flex items-center gap-x-3 min-w-0 cursor-pointer select-none hover:opacity-90 active:opacity-75 transition-opacity"
        id="logo-link"
        title="Перейти на главную"
        tabindex="0"
        role="button"
        onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); }"
      >
        <div class="hdr-brand-icon"><i class="fa-solid fa-tv"></i></div>
        <div class="min-w-0">
          <h1 class="text-xl md:text-2xl font-bold tracking-tighter section-header">
            Аниме Топ 2026
          </h1>
          <p
            class="text-xs text-[var(--text-muted)] whitespace-nowrap overflow-hidden text-ellipsis"
          >
            55 тайтлов • MyAnimeList • Июль 2026
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <!-- Random Anime Button -->
        <button id="random-btn" class="hdr-btn-icon" title="Случайное аниме">
          <i class="fa-solid fa-dice"></i>
        </button>

        <!-- Theme Toggle -->
        <button id="dark-btn" class="hdr-btn-icon theme-active" title="Тёмная тема">
          <i class="fa-solid fa-moon"></i>
        </button>
        <button id="light-btn" class="hdr-btn-icon" title="Светлая тема">
          <i class="fa-solid fa-sun"></i>
        </button>

        <span class="hdr-tag"
          ><span class="hdr-tag-dot"></span><span class="hidden sm:inline">Данные обновлены</span
          ></span
        >
      </div>
    </div>

    <!-- Нижний ряд: вкладки -->
    <nav class="hdr-nav" id="nav-tabs" role="tablist">
      <button
        class="nav-tab tab-active"
        id="tab-popularity"
        data-tab="popularity"
        role="tab"
        aria-selected="true"
        aria-controls="content-popularity"
        tabindex="0"
      >
        <i class="fa-solid fa-chart-line"></i><span>Аниме</span>
      </button>
      <button
        class="nav-tab"
        id="tab-imba"
        data-tab="imba"
        role="tab"
        aria-selected="false"
        aria-controls="content-imba"
        tabindex="-1"
      >
        <i class="fa-solid fa-fist-raised"></i><span>Самые имба ГГ</span>
      </button>
      <button
        class="nav-tab"
        id="tab-characters"
        data-tab="characters"
        role="tab"
        aria-selected="false"
        aria-controls="content-characters"
        tabindex="-1"
      >
        <i class="fa-solid fa-users"></i><span>Лучшие персонажи</span>
      </button>
      <button
        class="nav-tab"
        id="tab-ecchi"
        data-tab="ecchi"
        role="tab"
        aria-selected="false"
        aria-controls="content-ecchi"
        tabindex="-1"
      >
        <i class="fa-solid fa-fire"></i><span>Самый экки / интим</span>
      </button>
      <button
        class="nav-tab"
        id="tab-cute"
        data-tab="cute"
        role="tab"
        aria-selected="false"
        aria-controls="content-cute"
        tabindex="-1"
      >
        <i class="fa-solid fa-smile-beam"></i><span>Милые герои</span>
      </button>
      <button
        class="nav-tab"
        id="tab-ln"
        data-tab="ln"
        role="tab"
        aria-selected="false"
        aria-controls="content-ln"
        tabindex="-1"
      >
        <i class="fa-solid fa-book"></i><span>Мои лайт-новеллы</span>
      </button>

      <div id="tab-underline" class="tab-underline" role="presentation"></div>
    </nav>
  </div>
</header>
