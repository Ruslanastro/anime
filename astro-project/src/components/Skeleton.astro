---
// Skeleton.astro
// Skeleton-заглушки для lazy-загрузки вкладок
export interface Props {
  tab: string;
  count?: number;
}

const { tab, count: propCount } = Astro.props;
const count = propCount ?? (tab === 'popularity' ? 54 : tab === 'imba' ? 8 : 7);
const isLarge = tab === 'popularity';
---

{
  Array.from({ length: count }).map(() => (
    <div class={isLarge ? 'skeleton skeleton-large' : 'skeleton skeleton-info'}>
      {isLarge ? (
        <>
          <div class="skeleton-poster"></div>
          <div class="skeleton-content">
            <div class="skeleton-line w-3/4"></div>
            <div class="skeleton-line w-1/2"></div>
            <div class="skeleton-line w-2/3 mt-4"></div>
          </div>
        </>
      ) : (
        <>
          <div class="skeleton-line w-4/5"></div>
          <div class="skeleton-line w-3/5"></div>
          <div class="skeleton-line w-2/3 mt-3"></div>
        </>
      )}
    </div>
  ))
}