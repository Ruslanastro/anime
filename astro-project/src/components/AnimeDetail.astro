---
// AnimeDetail.astro
// Детальная страница аниме (скрыта по умолчанию, показывается при клике на карточку)
---

<div id="anime-detail-view" class="hidden">
  <div class="max-w-5xl mx-auto">
    <!-- Back navigation -->
    <button id="detail-back-btn"
            class="group mb-6 inline-flex items-center gap-2 rounded-2xl border border-[var(--border)] bg-[var(--card)]/80 px-4 py-2 text-sm font-medium text-[var(--text)]/90 transition-all hover:border-[var(--accent)]/40 hover:bg-[var(--card)] active:scale-[0.985]">
      <span class="transition-transform group-hover:-translate-x-0.5">←</span>
      <span>Назад к рейтингу</span>
    </button>

    <div class="flex flex-col gap-8 lg:flex-row">
      <!-- Large poster -->
      <div class="flex-shrink-0">
        <div class="relative">
          <img id="detail-poster" 
               class="w-full max-w-[340px] rounded-3xl border border-[var(--border)] shadow-2xl object-cover"
               alt="">
          <div id="detail-rank-badge"
               class="absolute -top-3 -left-3 rounded-2xl bg-[var(--accent)] px-4 py-1 text-sm font-bold text-white border border-[var(--accent)]/50"></div>
        </div>
      </div>

      <!-- Main info -->
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div id="detail-title" 
                 class="text-4xl font-bold tracking-tighter leading-none text-[var(--text)]"></div>
            <div id="detail-genre" 
                 class="mt-2 text-sm text-violet-400"></div>
          </div>
          <div class="text-right">
            <div class="text-[10px] uppercase tracking-[2px] text-[var(--text-muted)]">MAL SCORE</div>
            <div class="flex items-baseline justify-end gap-1">
              <span id="detail-score" class="text-emerald-400 text-5xl font-bold tabular-nums"></span>
              <span class="text-xl text-[var(--text-muted)]">/10</span>
            </div>
          </div>
        </div>

        <!-- Metadata grid -->
        <div id="detail-meta" 
             class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3 lg:grid-cols-4">
          <!-- Populated dynamically by JS -->
        </div>

        <!-- Description -->
        <div class="mt-7">
          <div class="mb-2 text-[10px] font-medium uppercase tracking-widest text-[var(--text-muted)]">Описание</div>
          <p id="detail-description" 
             class="text-[15px] leading-relaxed text-[var(--text)]/90 max-w-[65ch]"></p>
        </div>

        <!-- Main Characters -->
        <div class="mt-8">
          <div class="mb-3 text-[10px] font-medium uppercase tracking-widest text-[var(--text-muted)]">Главные персонажи</div>
          <div id="detail-characters" 
               class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Populated dynamically by JS -->
          </div>
        </div>

        <!-- MAL Link -->
        <div class="mt-8">
          <a id="detail-mal-link" 
             href="#" target="_blank" rel="noopener"
             class="group inline-flex items-center gap-3 rounded-2xl border border-[var(--border)] bg-[var(--card)]/80 px-5 py-3 text-sm font-medium text-[var(--text)]/90 transition-all hover:border-[var(--accent)]/60 hover:bg-[var(--accent)]/10 active:scale-[0.985]">
            <span>Открыть на MyAnimeList</span>
            <span class="text-[var(--accent)] transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>