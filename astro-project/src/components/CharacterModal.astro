---
// CharacterModal.astro
// Модальное окно с деталями персонажа (скрыто по умолчанию)
---

<div
  id="character-detail-modal"
  class="hidden fixed inset-0 z-[99999] flex items-center justify-center bg-black/60 light:bg-black/30 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="char-name"
>
  <div
    class="bg-[var(--card)] border border-[var(--border)] rounded-3xl max-w-[720px] w-full relative overflow-y-auto max-h-[90vh] shadow-2xl"
  >
    <!-- Close button -->
    <button
      id="char-modal-close"
      class="absolute top-4 right-4 z-10 flex h-9 w-9 items-center justify-center rounded-2xl border border-[var(--border)] bg-black/20 light:bg-white/50 text-xl text-[var(--text)]/70 light:text-[var(--text)] transition hover:bg-black/30 light:hover:bg-white/70"
      >×</button
    >

    <div class="p-7">
      <!-- Image -->
      <img
        id="char-image"
        class="mx-auto h-[450px] max-w-full object-cover object-bottom rounded-2xl mb-5 border border-white/10 shadow-lg hidden"
        alt=""
      />

      <!-- Header -->
      <div>
        <div id="char-anime" class="text-xs uppercase tracking-[2px] text-[var(--accent)]"></div>
        <h2 id="char-name" class="mt-1 text-4xl font-bold tracking-tighter text-[var(--text)]"></h2>
      </div>

      <!-- Info chips: race / age / alignment -->
      <div class="mt-5 flex flex-wrap items-center gap-2" id="char-chips"></div>

      <!-- Full description -->
      <div class="mt-6">
        <div class="text-[10px] font-medium uppercase tracking-widest text-[var(--text-muted)]">
          Описание
        </div>
        <p id="char-full-desc" class="mt-2 text-[15px] leading-relaxed text-[var(--text)]/90"></p>
      </div>

      <!-- Personality + Role -->
      <div class="mt-7 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <div class="text-[10px] font-medium uppercase tracking-widest text-[var(--text-muted)]">
            Характер
          </div>
          <p id="char-personality" class="mt-2 text-sm leading-relaxed text-[var(--text)]/85"></p>
        </div>
        <div>
          <div class="text-[10px] font-medium uppercase tracking-widest text-[var(--text-muted)]">
            Роль в истории
          </div>
          <p id="char-role" class="mt-2 text-sm leading-relaxed text-[var(--text)]/85"></p>
        </div>
      </div>

      <!-- Biography -->
      <div class="mt-7">
        <div class="text-[10px] font-medium uppercase tracking-widest text-[var(--text-muted)]">
          Биография (коротко)
        </div>
        <p id="char-biography" class="mt-2 text-sm leading-relaxed text-[var(--text)]/85"></p>
      </div>

      <!-- Powers & abilities -->
      <div class="mt-7" id="char-powers-wrap">
        <div class="text-[10px] font-medium uppercase tracking-widest text-[var(--text-muted)]">
          Силы и способности
        </div>
        <p id="char-powers" class="mt-2 text-sm leading-relaxed text-[var(--text)]/85"></p>
      </div>
    </div>

    <!-- Footer note -->
    <div
      class="border-t border-[var(--border)] bg-[var(--bg)]/50 px-7 py-3 text-center text-[10px] text-[var(--text-muted)]"
    >
      Данные: Shikimori • MAL • AniList • фандом-вики
    </div>

    <!-- Navigation: prev / next -->
    <div
      class="flex items-center justify-between gap-3 border-t border-[var(--border)] px-7 py-4"
    >
      <button
        id="char-modal-prev"
        class="flex h-10 items-center gap-2 rounded-2xl border border-[var(--border)] bg-[var(--card)] px-4 text-sm font-medium text-[var(--text)]/80 transition hover:border-[var(--accent)]/40 hover:text-[var(--text)]"
      >
        <i class="fa-solid fa-arrow-left"></i>
        <span>Назад</span>
      </button>
      <div id="char-modal-counter" class="text-xs font-mono text-[var(--text-muted)]"></div>
      <button
        id="char-modal-next"
        class="flex h-10 items-center gap-2 rounded-2xl border border-[var(--border)] bg-[var(--card)] px-4 text-sm font-medium text-[var(--text)]/80 transition hover:border-[var(--accent)]/40 hover:text-[var(--text)]"
      >
        <span>Вперёд</span>
        <i class="fa-solid fa-arrow-right"></i>
      </button>
    </div>
  </div>
</div>
