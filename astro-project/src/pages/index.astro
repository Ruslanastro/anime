---
// index.astro
// Главная страница — Аниме Топ 2026
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SearchBar from '../components/SearchBar.astro';
import AnimeCard from '../components/AnimeCard.astro';
import InfoCard from '../components/InfoCard.astro';
import AnimeDetail from '../components/AnimeDetail.astro';
import CharacterModal from '../components/CharacterModal.astro';
import Footer from '../components/Footer.astro';

import { animeData, imbaData, charactersData, ecchiData, cuteData } from '../data/animeData.js';
import { loliData } from '../data/loliData.js';
import { topCharactersData } from '../data/topCharactersData.js';
import { lnData } from '../data/lnData.js';
import LnCard from '../components/LnCard.astro';
import Skeleton from '../components/Skeleton.astro';
---

<BaseLayout>
  <Header />

  <div class="max-w-7xl mx-auto px-6 pb-16">
    <!-- POPULARITY TAB -->
    <div
      id="content-popularity"
      role="tabpanel"
      aria-labelledby="tab-popularity"
      aria-hidden="false"
    >
      <div id="popularity-header" class="flex items-end justify-between mb-6">
        <div>
          <h2 id="popularity-title" class="text-4xl font-bold tracking-tighter section-header">
            Топ по рейтингу MAL
          </h2>
          <p id="popularity-subtitle" class="text-[var(--text-muted)] mt-1">
            По оценке MyAnimeList (июль 2026)
          </p>
        </div>
        <div class="text-right">
          <div class="text-sm text-[var(--text-muted)]">Всего тайтлов</div>
          <div class="text-3xl font-bold text-violet-400">{animeData.length}</div>
        </div>
      </div>

      <!-- Sort controls -->
      <div id="popularity-sort" class="mb-4 flex items-center gap-2">
        <span class="text-sm text-[var(--text-muted)] mr-1">Сортировка:</span>
        <button
          id="sort-rating"
          class="px-4 py-1.5 text-sm rounded-xl border border-[var(--border)] bg-[var(--card)] border-[var(--accent)]/30 hover:bg-[var(--card)] active:bg-[var(--card)]"
          >По рейтингу MAL</button
        >
        <button
          id="sort-cozy"
          class="px-4 py-1.5 text-sm rounded-xl border border-[var(--border)] hover:bg-[var(--card)]/80 active:bg-[var(--card)]"
          >По уютности</button
        >
        <button
          id="sort-members"
          class="px-4 py-1.5 text-sm rounded-xl border border-[var(--border)] hover:bg-[var(--card)]/80 active:bg-[var(--card)]"
          >По участникам</button
        >
        <button
          id="sort-shiki"
          class="px-4 py-1.5 text-sm rounded-xl border border-[var(--border)] hover:bg-[var(--card)]/80 active:bg-[var(--card)]"
          >По рейтингу Shikimori</button
        >
      </div>

      <SearchBar tabId="popularity" placeholder="Поиск по названию или жанру..." />

      <div
        class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 gap-5"
        id="grid-popularity"
      >
        <div class="contents" id="skeleton-popularity">
          <Skeleton tab="popularity" count={20} />
        </div>
        <div class="contents hidden" id="content-popularity-cards">
          {animeData.map((anime, i) => <AnimeCard anime={anime} index={i} />)}
        </div>
      </div>

      <AnimeDetail />
    </div>

    <!-- IMBA TAB -->
    <div
      id="content-imba"
      class="hidden"
      role="tabpanel"
      aria-labelledby="tab-imba"
      aria-hidden="true"
    >
      <div class="mb-6">
        <h2 class="text-4xl font-bold tracking-tighter section-header">
          Топ самых имба главных героев
        </h2>
        <p class="text-[var(--text-muted)] mt-2">По уровню силы, развитию и влиянию на мир</p>
      </div>
      <SearchBar tabId="imba" placeholder="Поиск героя или аниме..." />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="grid-imba">
        {imbaData.map((hero, i) => <InfoCard type="imba" data={hero} index={i} />)}
      </div>
    </div>

    <!-- CHARACTERS TAB -->
    <div
      id="content-characters"
      class="hidden"
      role="tabpanel"
      aria-labelledby="tab-characters"
      aria-hidden="true"
    >
      <div class="mb-6">
        <h2 class="text-4xl font-bold tracking-tighter section-header">Лучшие персонажи</h2>
        <p class="text-[var(--text-muted)] mt-2">
          Топ-100 любимых героев из наших 54 тайтлов — по голосам зрителей MyAnimeList и AniList
        </p>
      </div>
      <SearchBar tabId="characters" placeholder="Поиск персонажа..." />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="grid-characters">
        {topCharactersData.map((char, i) => <InfoCard type="characters" data={char} index={i} />)}
      </div>
    </div>

    <!-- ECCHI TAB -->
    <div
      id="content-ecchi"
      class="hidden"
      role="tabpanel"
      aria-labelledby="tab-ecchi"
      aria-hidden="true"
    >
      <div class="mb-6">
        <div class="flex items-center gap-x-3">
          <h2 class="text-4xl font-bold tracking-tighter section-header">Самый экки / интим</h2>
          <div class="px-3 py-1 bg-red-500/20 text-red-400 text-xs font-bold rounded-full">18+</div>
        </div>
        <p class="text-[var(--text-muted)] mt-2">
          По уровню фансервиса и откровенности (на основе отзывов и репутации тайтлов)
        </p>
      </div>
      <SearchBar tabId="ecchi" placeholder="Поиск тайтла..." />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="grid-ecchi">
        {ecchiData.map((item, i) => <InfoCard type="ecchi" data={item} index={i} />)}
      </div>

      <div class="mt-8 p-4 bg-red-950/30 border border-red-500/30 rounded-2xl text-sm text-red-300">
        <i class="fa-solid fa-exclamation-triangle mr-2"></i>
        <strong>Внимание:</strong> "Гарем рабов в лабиринте другого мира" — один из самых откровенных исэкаев.
        Содержит очень детальные сцены (включая OVA без цензуры). Рекомендуется только взрослой аудитории.
      </div>
    </div>

    <!-- CUTE TAB -->
    <div
      id="content-cute"
      class="hidden"
      role="tabpanel"
      aria-labelledby="tab-cute"
      aria-hidden="true"
    >
      <div class="mb-6">
        <div class="flex items-center gap-x-3">
          <h2 class="text-4xl font-bold tracking-tighter section-header">Милые герои</h2>
          <div class="px-3 py-1 bg-amber-500/20 text-amber-400 text-xs font-bold rounded-full">
            Тепло и доброта
          </div>
        </div>
        <p class="text-[var(--text-muted)] mt-2">
          Тайтлы с особенно очаровательными, милыми и позитивными персонажами — детям и взрослым
        </p>
      </div>
      <SearchBar tabId="cute" placeholder="Поиск милого героя или тайтла..." />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="grid-cute">
        {cuteData.map((item, i) => <InfoCard type="cute" data={item} index={i} />)}
      </div>

      <div
        class="mt-8 p-4 bg-amber-950/30 border border-amber-500/30 rounded-2xl text-sm text-amber-300"
      >
        <i class="fa-solid fa-info-circle mr-2"></i>
        <strong>Примечание:</strong> Здесь собраны тайтлы, где главные или важные персонажи выглядят особенно
        мило и вызывают тёплые эмоции. Многие из них — комедии или истории про детей/подростков с позитивным
        уклоном.
      </div>
    </div>

    <!-- LOLI TAB -->
    <div
      id="content-loli"
      class="hidden"
      role="tabpanel"
      aria-labelledby="tab-loli"
      aria-hidden="true"
    >
      <div class="mb-6">
        <div class="flex items-center gap-x-3">
          <h2 class="text-4xl font-bold tracking-tighter section-header">Лоли</h2>
          <div class="px-3 py-1 bg-amber-500/20 text-amber-400 text-xs font-bold rounded-full">
            Субъективно
          </div>
        </div>
        <p class="text-[var(--text-muted)] mt-2">
          Тайтлы, где главный герой или ключевые персонажи имеют детскую внешность (с предупреждением)
        </p>
      </div>
      <SearchBar tabId="loli" placeholder="Поиск тайтла..." />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="grid-loli">
        {loliData.map((item, i) => <InfoCard type="loli" data={item} index={i} />)}
      </div>

      <div
        class="mt-8 p-4 bg-amber-950/30 border border-amber-500/30 rounded-2xl text-sm text-amber-300"
      >
        <i class="fa-solid fa-exclamation-triangle mr-2"></i>
        <strong>Важно:</strong> Список составлен на основе внешности персонажей и сюжетных
        особенностей. Многие тайтлы специально делают взрослого в теле ребёнка для комедийного
        эффекта. Не путать с «лоли-контентом» в негативном смысле.
      </div>
    </div>

    <!-- LN TAB -->
    <div id="content-ln" class="hidden" role="tabpanel" aria-labelledby="tab-ln" aria-hidden="true">
      <div class="mb-6">
        <h2 class="text-4xl font-bold tracking-tighter section-header">Мои лайт-новеллы</h2>
        <p class="text-[var(--text-muted)] mt-2">
          Собрано и отсортировано вручную • Информация обновлена 11 июля 2026
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="grid-ln">
        {lnData.map((item, i) => <LnCard data={item} index={i} />)}
      </div>
    </div>
  </div>

  <Footer />
  <CharacterModal />

  <!-- Client-side scripts -->
  <script>
    import('../scripts/main.js');
  </script>
</BaseLayout>
